NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=paper_control
DB_USER=paper_control_app
DB_PASSWORD=change_this_password
DB_CONNECTION_LIMIT=10

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Solo se usan con: npm run create-admin
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=PaperControl
ADMIN_EMAIL=admin@papercontrol.local
ADMIN_PASSWORD=replace_with_a_secure_password

PASSWORD_RESET_MINUTES=30
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/#/restablecer-contrasena

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=correo@gmail.com
MAIL_PASSWORD=replace_with_gmail_app_password
MAIL_FROM=PaperControl <correo@gmail.com>
